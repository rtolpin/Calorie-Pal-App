{
  "expo": {
    "name": "CaloriePal",
    "slug": "caloriepal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "caloriepal",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B35"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rtolpin.caloriepal",
      "buildNumber": "2",
      "deploymentTarget": "16.0",
      "infoPlist": {
        "NSCameraUsageDescription": "CaloriePal needs camera access to snap and analyze your meals",
        "NSPhotoLibraryUsageDescription": "CaloriePal needs photo access to upload meal photos",
        "NSPhotoLibraryAddUsageDescription": "CaloriePal needs photo access to save meal photos",
        "NSUserNotificationUsageDescription": "CaloriePal sends friendly reminders to log your meals",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "CaloriePal needs camera access to snap and analyze your meals"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CaloriePal needs photo access to upload meal photos"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF6B35",
          "sounds": []
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "08689af9-b6cb-4966-800d-3acbb792032c"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "rtolpin",
    "runtimeVersion": "1.0.0",
    "privacy": "unlisted",
    "updates": {
      "url": "https://u.expo.dev/08689af9-b6cb-4966-800d-3acbb792032c"
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    }
  }
}
